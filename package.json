{
  "name": "fluencyos",
  "private": true,
  "version": "0.1.0",
  "description": "FluencyOS desktop application",
  "author": {
    "name": "Team CSQuanta",
    "email": "tcsquanta@gmail.com"
  },
  "homepage": "https://github.com/Team-CSQuanta/fluency-os",
  "main": "dist-electron/main.cjs",
  "workspaces": [
    "renderer"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:renderer": "npm run build --workspace renderer",
    "build:electron": "node scripts/build-electron.mjs",
    "build": "npm run build:renderer && npm run build:electron",
    "test:backend": "cd backend && uv run pytest -n auto -q",
    "test": "node scripts/test-all.mjs",
    "test:beginner": "node scripts/test-beginner.mjs",
    "test:ui": "uv run --project backend pytest ui-tests -v --no-header -p no:cacheprovider -p no:warnings",
    "test:frontend": "npm run test --workspace renderer",
    "build:backend-runtime": "node scripts/build-backend-runtime.mjs",
    "dist": "npm run build && npm run build:backend-runtime && electron-builder --publish never",
    "dist:reuse-runtime": "npm run build && electron-builder --publish never"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.2",
    "typescript": "^5.7.3",
    "wait-on": "^8.0.1"
  }
}
