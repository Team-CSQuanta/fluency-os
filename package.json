{
  "name": "fluencyos",
  "private": true,
  "version": "0.1.0",
  "description": "FluencyOS desktop application",
  "main": "dist-electron/main.cjs",
  "workspaces": [
    "renderer"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:renderer": "npm run build --workspace renderer",
    "build:electron": "node scripts/build-electron.mjs",
    "build": "npm run build:renderer && npm run build:electron",
    "test:backend": "cd backend && uv run pytest -q"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.2",
    "typescript": "^5.7.3",
    "wait-on": "^8.0.1"
  }
}
